{
  "name": "paravalves-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Paravalves unified ERP + CRM + Engineering + Inventory + Procurement + Project + Finance platform",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "test": "vitest run",
    "test:e2e": "node --conditions=react-server --import tsx scripts/e2e-chain.ts",
    "db:client-demo": "node --conditions=react-server --import tsx scripts/seed-client-demo.ts",
    "db:demo": "node --conditions=react-server --import tsx scripts/seed-demo.ts",
    "test:e2e:browser": "playwright test",
    "vercel-build": "next build",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "decimal.js": "^10.4.3",
    "next": "^15.1.6",
    "nodemailer": "^9.1.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
