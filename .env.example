# ---------------------------------------------------------------------------
# Paravalves Platform — environment configuration
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://paravalves:paravalves_dev_pw@127.0.0.1:55432/paravalves
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# --- Security -------------------------------------------------------------
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=CHANGE_ME_BASE64_32_BYTES
FILE_TOKEN_SECRET=CHANGE_ME_BASE64_32_BYTES
SESSION_TTL_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=120
COOKIE_SECURE=false

# --- Public website inquiry endpoint --------------------------------------
# Shared secret the Paravalves marketing site sends in X-Paravalves-Key
WEBSITE_INQUIRY_API_KEY=CHANGE_ME_WEBSITE_KEY
WEBSITE_INQUIRY_RATE_PER_HOUR=20
WEBSITE_ALLOWED_ORIGINS=https://paravalves.com,https://www.paravalves.com

# --- File storage ---------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
MAX_UPLOAD_BYTES=26214400

# --- Email ----------------------------------------------------------------
# MAIL_DRIVER: log | smtp
MAIL_DRIVER=log
MAIL_FROM="Paravalves <no-reply@paravalves.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Jobs -----------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_POLL_MS=2000

# --- Observability --------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=pretty
